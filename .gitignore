# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Node
node_modules/

# Env / secrets — never commit keys
.env
.env.*
!.env.example
*.key
secrets.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Large binary media — keep out of git; store via releases / OneDrive
assets/video/*.mp4
assets/video/*.mov
assets/presentation/*.pptx
!assets/**/README.md
!assets/**/.gitkeep

# Data / generated outputs
samples/output/
*.log
